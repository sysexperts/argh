{
    "name": "sys-experts/business-manager",
    "description": "Modulare mandantenfähige Business-Software",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.0",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "robmorgan/phinx": "^0.14",
        "vlucas/phpdotenv": "^5.5",
        "monolog/monolog": "^2.9",
        "respect/validation": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "SysExperts\\BusinessManager\\": "core/",
            "SysExperts\\BusinessManager\\Modules\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "vendor/bin/phinx migrate",
        "migrate:rollback": "vendor/bin/phinx rollback",
        "migrate:create": "vendor/bin/phinx create"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
