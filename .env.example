# App-Konfiguration
APP_NAME="Business Manager"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

# Datenbank (SQLite)
DB_CONNECTION=sqlite
DB_DATABASE=database/business_manager.sqlite

# Datenbank (MySQL - auskommentiert)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=business_manager
# DB_USERNAME=root
# DB_PASSWORD=

# Lizenz-API (Partner-Konsole)
LICENSE_API_URL=https://partner.sys-experts.de/api/v1
LICENSE_API_KEY=
LICENSE_CHECK_INTERVAL=86400

# Mandant
TENANT_ID=
TENANT_NAME="Meine Firma GmbH"

# Mail
MAIL_DRIVER=smtp
MAIL_HOST=smtp.strato.de
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Session
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_HTTP_ONLY=true

# Logging
LOG_LEVEL=info
LOG_FILE=storage/logs/app.log
